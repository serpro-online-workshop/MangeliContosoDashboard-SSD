@using Microsoft.AspNetCore.Components.Forms
@using ContosoDashboard.Models
@inject IDocumentService DocumentService
@inject IProjectService ProjectService

<section class="mb-4" aria-labelledby="upload-heading">
    <h2 id="upload-heading" class="h4">Upload documents</h2>

    <div class="mb-3">
        <label class="form-label" for="document-files">Files</label>
        <InputFile id="document-files" @key="inputKey" OnChange="HandleFilesAsync" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" />
        <div class="form-text">PDF, Office, text, JPEG or PNG. Maximum 25 MB per file.</div>
    </div>

    @if (entries.Count > 0)
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label" for="document-category">Category</label>
                <select id="document-category" class="form-select" @bind="category">
                    <option value="">Select a category</option>
                    @foreach (var item in DocumentCategories.All)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="document-project">Project</label>
                <select id="document-project" class="form-select" @bind="projectId">
                    <option value="">Personal / no project</option>
                    @foreach (var project in projects)
                    {
                        <option value="@project.ProjectId">@project.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="document-tags">Tags</label>
                <input id="document-tags" class="form-control" @bind="tagsText" placeholder="Separate with commas" />
            </div>
            <div class="col-12">
                <label class="form-label" for="document-description">Description</label>
                <textarea id="document-description" class="form-control" rows="2" maxlength="2000" @bind="description"></textarea>
            </div>
        </div>

        <div class="list-group mb-3">
            @foreach (var entry in entries)
            {
                <div class="list-group-item" @key="entry.Id">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div class="flex-grow-1">
                            <label class="form-label" for="title-@entry.Id">Title</label>
                            <input id="title-@entry.Id" class="form-control" maxlength="255" @bind="entry.Title" disabled="@(entry.Status != "Ready")" />
                            <div class="small text-muted mt-1">@entry.FileName · @FormatFileSize(entry.Size)</div>
                        </div>
                        <div class="align-self-end">@entry.Status</div>
                    </div>
                    @if (entry.Progress > 0 && entry.Progress < 100)
                    {
                        <div class="progress mt-2" role="progressbar" aria-label="Uploading @entry.FileName" aria-valuenow="@entry.Progress" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @entry.Progress%">@entry.Progress%</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Error))
                    {
                        <div class="text-danger small mt-1" role="alert">@entry.Error</div>
                    }
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(formError))
        {
            <div class="alert alert-danger" role="alert">@formError</div>
        }

        <button type="button" class="btn btn-primary" @onclick="UploadAsync" disabled="@isUploading">
            @(isUploading ? "Uploading..." : "Upload selected files")
        </button>
    }
</section>

@code {
    [Parameter] public int UserId { get; set; }
    [Parameter] public EventCallback OnUploaded { get; set; }

    private readonly List<UploadEntry> entries = [];
    private List<Project> projects = [];
    private string category = string.Empty;
    private string? description;
    private string tagsText = string.Empty;
    private int? projectId;
    private int inputKey;
    private bool isUploading;
    private string? formError;

    protected override async Task OnParametersSetAsync()
    {
        if (UserId > 0)
        {
            projects = await ProjectService.GetUserProjectsAsync(UserId);
        }
    }

    private async Task HandleFilesAsync(InputFileChangeEventArgs args)
    {
        entries.Clear();
        formError = null;
        foreach (var browserFile in args.GetMultipleFiles(10))
        {
            var fileName = browserFile.Name;
            var fileSize = browserFile.Size;
            var entry = new UploadEntry(fileName, fileSize);
            entries.Add(entry);

            if (fileSize <= 0 || fileSize > DocumentValidator.MaximumFileSize)
            {
                entry.Status = "Rejected";
                entry.Error = fileSize <= 0 ? "Empty files are not supported." : "Files must be 25 MB or smaller.";
                continue;
            }

            try
            {
                await using var fileStream = browserFile.OpenReadStream(DocumentValidator.MaximumFileSize);
                await using var memoryStream = new MemoryStream();
                var buffer = new byte[81920];
                long copied = 0;
                int read;
                while ((read = await fileStream.ReadAsync(buffer)) > 0)
                {
                    await memoryStream.WriteAsync(buffer.AsMemory(0, read));
                    copied += read;
                    entry.Progress = (int)Math.Min(99, copied * 100 / fileSize);
                    await InvokeAsync(StateHasChanged);
                }

                entry.Content = memoryStream.ToArray();
                entry.Title = Path.GetFileNameWithoutExtension(fileName);
                entry.Status = "Ready";
                entry.Progress = 100;
            }
            catch (Exception exception) when (exception is IOException or InvalidOperationException)
            {
                entry.Status = "Rejected";
                entry.Error = "The file could not be read.";
            }
        }
    }

    private async Task UploadAsync()
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            formError = "Choose a category before uploading.";
            return;
        }

        if (entries.Any(entry => entry.Status == "Ready" && string.IsNullOrWhiteSpace(entry.Title)))
        {
            formError = "Enter a title for each selected file.";
            return;
        }

        formError = null;
        isUploading = true;
        try
        {
            foreach (var entry in entries.Where(entry => entry.Status == "Ready"))
            {
                entry.Status = "Uploading";
                var request = new DocumentUploadRequest
                {
                    Title = entry.Title,
                    Category = category,
                    Description = description,
                    ProjectId = projectId,
                    Tags = tagsText.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
                    File = new DocumentFilePayload { FileName = entry.FileName, Size = entry.Size, Content = entry.Content! }
                };
                var result = await DocumentService.UploadAsync(request, UserId);
                entry.Status = result.Success ? "Uploaded" : "Rejected";
                entry.Error = result.Error;
            }

            inputKey++;
            await OnUploaded.InvokeAsync();
        }
        finally
        {
            isUploading = false;
        }
    }

    private static string FormatFileSize(long size) =>
        size >= 1024 * 1024 ? $"{size / 1024d / 1024d:0.##} MB" : $"{size / 1024d:0.##} KB";

    private sealed class UploadEntry(string fileName, long size)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string FileName { get; } = fileName;
        public long Size { get; } = size;
        public string Title { get; set; } = string.Empty;
        public byte[]? Content { get; set; }
        public int Progress { get; set; }
        public string Status { get; set; } = "Reading";
        public string? Error { get; set; }
    }
}
